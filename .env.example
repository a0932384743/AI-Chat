# Base URL of your LiteLLM proxy server (litellm --config config.yaml)
LITELLM_BASE_URL=http://localhost:4000

# Virtual key / master key configured on the LiteLLM proxy
LITELLM_API_KEY=sk-litellm-master-key

# Model name as registered in the LiteLLM proxy config (model_list -> model_name)
LITELLM_MODEL=gpt-4o-mini

# Vision-capable model used to transcribe/describe uploaded images for the
# knowledge base. Defaults to LITELLM_MODEL if unset.
# LITELLM_VISION_MODEL=gpt-4o-mini

# Embedding model used to index and search knowledge base documents. Must be
# registered in the LiteLLM proxy config (see litellm.config.example.yaml).
LITELLM_EMBEDDING_MODEL=text-embedding-3-small

# Where knowledge base files (extracted text + embeddings) are persisted.
# KB_DATA_DIR=./data

# Max upload size in MB for knowledge base documents.
# KB_MAX_FILE_SIZE_MB=15

# Retrieval tuning: how many chunks to feed the model, and the minimum
# cosine-similarity score for a chunk to be considered relevant.
# KB_TOP_K=4
# KB_MIN_SIMILARITY=0.75

# Base URL of your LiteLLM proxy server (litellm --config config.yaml)
LITELLM_BASE_URL=http://localhost:4000

# Virtual key / master key configured on the LiteLLM proxy
LITELLM_API_KEY=sk-litellm-master-key

# Model name as registered in the LiteLLM proxy config (model_list -> model_name)
LITELLM_MODEL=gpt-4o-mini
